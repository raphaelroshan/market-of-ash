; Engine configuration file.
; Market of Ash — agent-first Godot prototype
; Godot 4.x

config_version=5

[application]
config/name="Market of Ash"
config/version="0.9.0-alpha-roadmap"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.047, 0.039, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.039, 1)

[input]
ui_accept={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]}
ui_cancel={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]}
ui_pause={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":80), Object(InputEventJoypadButton,"button_index":6)]}

[debug]

[gui]
theme/default_font_multichannel_signed_distance_field=true

[market_of_ash]
build_commit="development"
build_run="local"
